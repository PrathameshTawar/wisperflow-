# Copy this file to .env and fill in keys you want to activate.
# 1. Vision-Language Model (recommended for full scene & signboard description):
GEMINI_API_KEY=your_gemini_api_key_here
# Or Anthropic Claude Vision:
# ANTHROPIC_API_KEY=your_anthropic_api_key_here

# 2. Sarvam AI (recommended for natural Hindi/Marathi/Indian-language STT & TTS):
SARVAM_API_KEY=your_sarvam_api_key_here

# 3. Local offline speech fallback model size:
WHISPER_MODEL_SIZE=base

# 4. Optional comma-separated allowed CORS origins (defaults to local Vite dev origins):
# CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
